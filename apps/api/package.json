{
  "name": "@helpdesk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "seed": "node dist/seed.mjs",
    "tickets:classify": "tsx --env-file-if-exists=../../.env src/classify-tickets.ts",
    "tickets:auto-resolve": "tsx --env-file-if-exists=../../.env src/auto-resolve-tickets.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.95",
    "@helpdesk/db": "^0.0.0",
    "@helpdesk/shared": "^0.0.0",
    "ai": "^7.0.140",
    "better-auth": "^1.7.7",
    "express": "^5.2.1",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
