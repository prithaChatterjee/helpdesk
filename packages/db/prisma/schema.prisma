generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// Auth tables follow Better Auth's core schema (user, session, account, verification).
// Field mappings that differ from Better Auth's names are configured in apps/api/src/auth.ts.

enum UserRole {
  ADMIN
  AGENT
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  role            UserRole  @default(AGENT)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  // Soft delete: set when an Admin deletes the user (who is also deactivated). Deleted users are
  // hidden from the API but keep their row, so the email stays taken and history stays linked.
  deletedAt       DateTime? @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]
  sentMessages    Message[]
  /// Tickets this user is working on; unassigned when the user is deleted
  assignedTickets Ticket[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Better Auth session token (mapped from `token`); the cookie carries it HMAC-signed
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  /// Better Auth `updatedAt`; bumped when the session is refreshed
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One sign-in method for a user. Email/password users have providerId "credential"
/// and the password hash in `password`.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens (email verification, password reset). Unused until those flows exist.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL
  TECHNICAL
  REFUND
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Whether an outbound message was emailed to the customer
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// A customer conversation, created from the first inbound email.
model Ticket {
  id            String          @id @default(uuid(7)) @db.Uuid
  subject       String
  status        TicketStatus    @default(OPEN)
  /// Empty until the AI (or an Agent) classifies the ticket
  category      TicketCategory?
  customerEmail String
  customerName  String?
  summary       String?
  /// The Admin or Agent working on the ticket; empty while unassigned
  assignedToId  String?         @db.Uuid
  assignedTo    User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  /// Bumped whenever a message is added, so the list can sort by latest activity
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  messages      Message[]

  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([customerEmail])
  @@index([assignedToId])
  @@map("tickets")
}

/// One email in a ticket's thread: inbound from the customer or outbound from an Agent.
model Message {
  id             String           @id @default(uuid(7)) @db.Uuid
  ticketId       String           @db.Uuid
  ticket         Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  fromEmail      String
  fromName       String?
  bodyText       String
  /// Sanitized before storage
  bodyHtml       String?
  /// RFC 5322 Message-ID without angle brackets; unique so duplicate deliveries are ignored
  emailMessageId String?          @unique
  inReplyTo      String?
  references     String[]
  /// The Agent who sent an outbound message
  sentByUserId   String?          @db.Uuid
  sentBy         User?            @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  /// Outbound only: null when it was saved while email sending was off
  deliveryStatus DeliveryStatus?
  /// Why the last send attempt failed (provider response), for debugging
  deliveryError  String?
  /// When the email provider accepted the message
  sentAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@index([ticketId, createdAt])
  @@map("messages")
}
