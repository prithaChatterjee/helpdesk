# Copy to .env and adjust. Loaded by the api and worker in development.
NODE_ENV=development

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database / queue (match docker-compose.yml)
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk
REDIS_URL=redis://localhost:6379

# Admin account: created on first API startup when no users exist, or any time with `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Better Auth. Generate the secret with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional extra user for `npm run db:seed`. SEED_USER_ROLE is ADMIN or AGENT (default AGENT).
# SEED_USER_EMAIL=agent@example.com
# SEED_USER_PASSWORD=change-me-please
# SEED_USER_ROLE=AGENT
