# Copy to .env and adjust. Loaded by the api and worker in development.
NODE_ENV=development

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database / queue (match docker-compose.yml)
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk
REDIS_URL=redis://localhost:6379

# Admin account: created on first API startup when no users exist, or any time with `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Better Auth. Generate the secret with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Bearer token the mail pipeline sends to POST /api/webhooks/inbound-email (generate like the secret above)
INBOUND_EMAIL_SECRET=replace-with-another-32-plus-random-characters

# Gemini API key from https://aistudio.google.com for polishing replies and summarizing (api) and
# classifying tickets (worker). Optional: without it those features are off and classify-ticket
# jobs wait in the queue. The free tier may use requests to improve Google's products.
# GOOGLE_GENERATIVE_AI_API_KEY=
# Most ticket classifications per minute (worker). The free tier allows about 5 per model; raise on a paid key.
# AI_REQUESTS_PER_MINUTE=4
# The support address (worker): sender of emailed replies and of the AI's auto-resolve replies.
# With email sending on, it must be a SendGrid verified sender (Settings → Sender Authentication).
# SUPPORT_EMAIL=support@helpdesk.example

# SendGrid. Off by default, so replies to test tickets with made-up addresses are never emailed.
# Set EMAIL_SENDING_ENABLED=true for both api (queues Agent replies) and worker (sends them, and the
# AI's replies). The API key needs the "Mail Send" permission.
# EMAIL_SENDING_ENABLED=false
# SENDGRID_API_KEY=
# Reply-To of emailed replies, e.g. your Inbound Parse address; unset, customers reply to SUPPORT_EMAIL
# EMAIL_REPLY_TO=
# Inbound: point SendGrid Inbound Parse at
#   https://<public host>/api/webhooks/sendgrid/inbound?token=<INBOUND_EMAIL_SECRET>

# Sentry error reporting (https://sentry.io), api and worker. Optional: unset, errors are only logged.
# Events are tagged service=api|worker. The web app has its own VITE_SENTRY_DSN (and optional
# VITE_SENTRY_ENVIRONMENT) in apps/web/.env or the build environment, not here: Vite reads .env from
# apps/web, and this file's NODE_ENV=development would make `vite build` ship React's dev build.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=

# Optional extra user for `npm run db:seed`. SEED_USER_ROLE is ADMIN or AGENT (default AGENT).
# SEED_USER_EMAIL=agent@example.com
# SEED_USER_PASSWORD=change-me-please
# SEED_USER_ROLE=AGENT
# db:seed refuses to run when NODE_ENV=production (it resets the Admin password) unless this is true
# SEED_ALLOW_PRODUCTION=false
