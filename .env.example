# Copy to .env and adjust. Loaded by the api and worker in development.
NODE_ENV=development

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database / queue (match docker-compose.yml)
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk
REDIS_URL=redis://localhost:6379

# Initial Admin, created on first startup when no users exist (Phase 1)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
