{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "package.json",
      "package-lock.json",
      "Dockerfile"
    ]
  },
  "deploy": {
    "startCommand": "node apps/worker/dist/index.mjs",
    "restartPolicyType": "ON_FAILURE"
  }
}
