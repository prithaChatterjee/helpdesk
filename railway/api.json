{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "apps/web/**",
      "packages/**",
      "package.json",
      "package-lock.json",
      "Dockerfile"
    ]
  },
  "deploy": {
    "preDeployCommand": "npm run db:deploy",
    "startCommand": "node apps/api/dist/index.mjs",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
